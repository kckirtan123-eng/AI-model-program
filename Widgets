class ModernButton(tk.Button):
    """Modern styled button with hover effects"""
    
    def __init__(self, master=None, **kwargs):
        # Default modern styling
        defaults = {
            'bg': '#4A90E2',
            'fg': 'white',
            'font': ('Arial', 10, 'bold'),
            'relief': 'flat',
            'bd': 0,
            'padx': 15,
            'pady': 8,
            'cursor': 'hand2'
        }
        defaults.update(kwargs)
        super().__init__(master, **defaults)
        
        self.original_bg = defaults['bg']
        self.hover_bg = self._lighten_color(self.original_bg, 20)
        
        self.bind("<Enter>", self.on_enter)
        self.bind("<Leave>", self.on_leave)
    
    def _lighten_color(self, color, percent):
        """Lighten a color by given percentage"""
        if isinstance(color, str) and color.startswith('#'):
            color = color[1:]
            rgb = tuple(int(color[i:i+2], 16) for i in (0, 2, 4))
        else:
            return color
            
        light_rgb = tuple(min(255, int(c * (1 + percent/100))) for c in rgb)
        return f'#{light_rgb[0]:02x}{light_rgb[1]:02x}{light_rgb[2]:02x}'
    
    def on_enter(self, event):
        self.configure(bg=self.hover_bg)
    
    def on_leave(self, event):
        self.configure(bg=self.original_bg)
    
    
    def add_loading_decorator(self, func: Callable) -> Callable:
        """Decorator to add loading animation to button clicks"""
        def wrapper():
            original_text = self['text']
            self['text'] = "⏳ Processing..."
            self['state'] = 'disabled'
            self['bg'] = '#95a5a6'
            
            try:
                result = func()
            except Exception as e:
                result = f"Error: {e}"
            finally:
                self['text'] = original_text
                self['state'] = 'normal'
                self['bg'] = self.original_bg
            
            return result
        return wrapper

class CardFrame(ttk.Frame):
    """Modern card-style frame with shadow effect"""
    
    def __init__(self, master=None, title="", **kwargs):
        super().__init__(master, **kwargs)
        self.configure(relief='raised', borderwidth=1)
        
        if title:
            title_frame = ttk.Frame(self)
            title_frame.pack(fill='x', padx=10, pady=(10, 5))
            
            title_label = tk.Label(
                title_frame, 
                text=title, 
                font=('Arial', 12, 'bold'),
                fg='#2c3e50',
                bg=self.cget('background')
            )
            title_label.pack(anchor='w')
            
            separator = ttk.Separator(self, orient='horizontal')
            separator.pack(fill='x', padx=10, pady=5)

class ModernToolTip:
    """Modern tooltip with better styling"""
    
    def __init__(self, widget, text):
        self.widget = widget
        self.text = text
        self.tooltip = None
        self.widget.bind("<Enter>", self.show_tooltip)
        self.widget.bind("<Leave>", self.hide_tooltip)
    
    def show_tooltip(self, event=None):
        """Show modern tooltip on hover"""
        if self.tooltip:
            return
            
        x, y, _, _ = self.widget.bbox("insert")
        x += self.widget.winfo_rootx() + 25
        y += self.widget.winfo_rooty() + 25
        
        self.tooltip = tk.Toplevel(self.widget)
        self.tooltip.wm_overrideredirect(True)
        self.tooltip.wm_geometry(f"+{x}+{y}")
        self.tooltip.configure(bg='#34495e', relief='solid', borderwidth=1)
        
        label = tk.Label(
            self.tooltip, 
            text=self.text, 
            bg='#34495e',
            fg='white',
            font=('Arial', 8),
            padx=8,
            pady=4
        )
        label.pack()
    
    def hide_tooltip(self, event=None):
        """Hide tooltip"""
        if self.tooltip:
            self.tooltip.destroy()
            self.tooltip = None

class OutputDisplay(tk.Frame):
    """Modern output display with syntax highlighting-like appearance"""
    
    def __init__(self, master, title="Output", height=12, **kwargs):
        super().__init__(master, **kwargs)
        self.configure(bg='#2c3e50', relief='sunken', bd=1)
        
        # Header
        header_frame = tk.Frame(self, bg='#34495e')
        header_frame.pack(fill='x', padx=1, pady=(1, 0))
        
        title_label = tk.Label(
            header_frame,
            text=title,
            font=('Arial', 10, 'bold'),
            fg='#ecf0f1',
            bg='#34495e',
            padx=10,
            pady=5
        )
        title_label.pack(side='left')
        
        # Clear button
        clear_btn = ModernButton(
            header_frame,
            text="🗑️",
            command=self.clear,
            bg='#e74c3c',
            font=('Arial', 8),
            padx=5,
            pady=2
        )
        clear_btn.pack(side='right', padx=5, pady=2)
        
        # Text area with scrollbar
        text_frame = tk.Frame(self, bg='#2c3e50')
        text_frame.pack(fill='both', expand=True, padx=1, pady=(0, 1))
        
        self.text_widget = tk.Text(
            text_frame,
            height=height,
            width=80,
            bg='#2c3e50',
            fg='#ecf0f1',
            font=('Consolas', 9),
            insertbackground='white',
            selectbackground='#3498db',
            relief='flat',
            padx=10,
            pady=10,
            wrap='word'
        )
        self.text_widget.pack(side='left', fill='both', expand=True)
        
        # Scrollbar
        scrollbar = ttk.Scrollbar(text_frame, command=self.text_widget.yview)
        scrollbar.pack(side='right', fill='y')
        self.text_widget.config(yscrollcommand=scrollbar.set)
        
        # Configure tags for different message types
        self.text_widget.tag_configure('success', foreground='#2ecc71')
        self.text_widget.tag_configure('error', foreground='#e74c3c')
        self.text_widget.tag_configure('warning', foreground='#f39c12')
        self.text_widget.tag_configure('info', foreground='#3498db')
        self.text_widget.tag_configure('system', foreground='#95a5a6')
    
    
    def log(self, message, message_type='info'):
        """Add a message with colored formatting"""
        timestamp = self._get_timestamp()
        self.text_widget.insert(tk.END, f"[{timestamp}] ", 'system')
        self.text_widget.insert(tk.END, f"{message}\n", message_type)
        self.text_widget.see(tk.END)
    
    def clear(self):
        """Clear all output"""
        self.text_widget.delete(1.0, tk.END)
        self.log("Output cleared", 'system')
    
    def _get_timestamp(self):
        """Get current timestamp"""
        from datetime import datetime
        return datetime.now().strftime("%H:%M:%S")

class ImageDisplay(tk.Frame):
    """Modern image display with placeholder and status"""
    
    def __init__(self, master, title="Image Display", width=400, height=250):
        super().__init__(master)
        self.configure(relief='sunken', bd=1, bg='#ecf0f1')
        self.width = width
        self.height = height
        
        # Title
        title_label = tk.Label(
            self, 
            text=title, 
            font=('Arial', 11, 'bold'),
            fg='#2c3e50',
            bg='#ecf0f1',
            pady=8
        )
        title_label.pack()
        
        # Image display area
        self.image_frame = tk.Frame(self, bg='#bdc3c7', width=width, height=height)
        self.image_frame.pack(padx=10, pady=10)
        self.image_frame.pack_propagate(False)
        
        self.image_label = tk.Label(
            self.image_frame, 
            text="🖼️ No Image Loaded",
            font=('Arial', 10),
            fg='#7f8c8d',
            bg='#bdc3c7',
            compound='top'
        )
        self.image_label.pack(expand=True)
        
        # Status bar
        self.status_var = tk.StringVar(value="Ready")
        status_bar = tk.Label(
            self,
            textvariable=self.status_var,
            font=('Arial', 8),
            fg='#7f8c8d',
            bg='#ecf0f1',
            relief='sunken',
            bd=1
        )
        status_bar.pack(fill='x', side='bottom')
    
    def display_image(self, photo_image):
        """Display a PhotoImage in the widget"""
        self.image_label.configure(image=photo_image, text="")
        self.image_label.image = photo_image  # Keep reference
        self.status_var.set("Image displayed")
    
    def clear(self):
        """Clear the display"""
        self.image_label.configure(image='', text="🖼️ No Image Loaded")
        self.status_var.set("Ready")

class ProgressBar(tk.Frame):
    """Modern progress bar with percentage"""
    
    def __init__(self, master, **kwargs):
        super().__init__(master, **kwargs)
        
        self.progress_var = tk.DoubleVar()
        self.status_var = tk.StringVar(value="Ready")
        
        # Status label
        self.status_label = tk.Label(
            self,
            textvariable=self.status_var,
            font=('Arial', 9),
            fg='#2c3e50'
        )
        self.status_label.pack(anchor='w')
        
        # Progress bar
        style = ttk.Style()
        style.configure("Modern.Horizontal.TProgressbar",
                       troughcolor='#ecf0f1',
                       background='#3498db',
                       thickness=20)
        
        self.progress = ttk.Progressbar(
            self,
            variable=self.progress_var,
            style="Modern.Horizontal.TProgressbar",
            maximum=100
        )
        self.progress.pack(fill='x', pady=(2, 0))
    
    def update_progress(self, value, status=""):
        """Update progress bar and status"""
        self.progress_var.set(value)
        if status:
            self.status_var.set(status)

# Decorator function for logging
def log_execution(func: Callable) -> Callable:
    """Decorator to log function execution"""
    def wrapper(*args, **kwargs):
        print(f"🚀 Executing {func.__name__}")
        result = func(*args, **kwargs)
        print(f"✅ Completed {func.__name__}")
        return result
    return wrapper
