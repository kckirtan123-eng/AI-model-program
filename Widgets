import tkinter as tk
from tkinter import ttk
from typing import Callable
from PIL import Image, ImageTk

class ModernButton(tk.Button):
    """Modern styled button with hover effects"""
    
    def __init__(self, master=None, **kwargs):
        # Default modern styling
        defaults = {
            'bg': '#4A90E2',
            'fg': 'white',
            'font': ('Arial', 10, 'bold'),
            'relief': 'flat',
            'bd': 0,
            'padx': 15,
            'pady': 8,
            'cursor': 'hand2'
        }
        defaults.update(kwargs)
        super().__init__(master, **defaults)
        
        self.original_bg = defaults['bg']
        self.hover_bg = self._lighten_color(self.original_bg, 20)
        
        self.bind("<Enter>", self.on_enter)
        self.bind("<Leave>", self.on_leave)
    
    def _lighten_color(self, color, percent):
        """Lighten a color by given percentage"""
        if isinstance(color, str) and color.startswith('#'):
            color = color[1:]
            rgb = tuple(int(color[i:i+2], 16) for i in (0, 2, 4))
        else:
            return color
            
        light_rgb = tuple(min(255, int(c * (1 + percent/100))) for c in rgb)
        return f'#{light_rgb[0]:02x}{light_rgb[1]:02x}{light_rgb[2]:02x}'
    
    def on_enter(self, event):
        self.configure(bg=self.hover_bg)
    
    def on_leave(self, event):
        self.configure(bg=self.original_bg)
    
