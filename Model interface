import tkinter as tk
from tkinter import ttk, filedialog, messagebox
import threading
import time
import os

class ModelInterface(tk.Frame):
    def __init__(self, parent, models_dict):
        super().__init__(parent)
        self.parent = parent
        self.models = models_dict
        self.current_model = None
        self.current_step = 1
        self.file_path = None  # Initialize file_path
        
        self.configure(bg='#2b2b2b')
        self.pack(fill='both', expand=True)
        
        self.setup_ui()
        
    def setup_ui(self):
        """Setup the main interface layout"""
        print("🔧 Setting up UI...")
        
        # Main container
        self.main_container = tk.Frame(self, bg='#2b2b2b')
        self.main_container.pack(fill='both', expand=True, padx=20, pady=20)
        
        # Title
        self.title_label = tk.Label(
            self.main_container,
            text="🎯 AI MODEL WIZARD",
            font=('Arial', 18, 'bold'),
            fg='white',
            bg='#007acc',
            pady=15
        )
        self.title_label.pack(fill='x', pady=(0, 20))
        
        # Model selection
        self.setup_model_selection()
        
        # Create steps container
        self.steps_container = tk.Frame(self.main_container, bg='#2b2b2b')
        self.steps_container.pack(fill='both', expand=True, pady=10)
        
        # Create all steps
        self.create_step1()
        self.create_step2() 
        self.create_step3()
        self.create_step4()
        
        # Show first step
        self.show_step(1)
        
    def setup_model_selection(self):
        """Setup model selection area"""
        model_frame = tk.Frame(self.main_container, bg='#3c3c3c', relief='raised', bd=1)
        model_frame.pack(fill='x', pady=10, padx=10)
        
        tk.Label(
            model_frame,
            text="SELECT MODEL:",
            font=('Arial', 12, 'bold'),
            fg='white',
            bg='#3c3c3c'
        ).pack(side='left', padx=10, pady=10)
        
        # Model dropdown
        self.model_var = tk.StringVar()
        self.model_dropdown = ttk.Combobox(
            model_frame,
            textvariable=self.model_var,
            values=list(self.models.keys()),
            state='readonly',
            width=20,
            font=('Arial', 10)
        )
        self.model_dropdown.pack(side='left', padx=10, pady=10)
        self.model_dropdown.bind('<<ComboboxSelected>>', self.on_model_selected)
        
        # Status label
        self.model_status = tk.Label(
            model_frame,
            text="Please select a model to begin",
            font=('Arial', 10),
            fg='#cccccc',
            bg='#3c3c3c'
        )
        self.model_status.pack(side='left', padx=20, pady=10)
        
    def create_step1(self):
        """Step 1: Model Selection Confirmation"""
        self.step1 = tk.Frame(self.steps_container, bg='#2b2b2b')
        
        content = tk.Frame(self.step1, bg='#2b2b2b')
        content.pack(fill='both', expand=True, padx=20, pady=20)
        
        tk.Label(
            content,
            text="STEP 1: MODEL SELECTION",
            font=('Arial', 14, 'bold'),
            fg='white',
            bg='#2b2b2b'
        ).pack(pady=(0, 10))
        
        tk.Label(
            content,
            text="Please select an AI model from the dropdown above to continue.",
            font=('Arial', 11),
            fg='#cccccc',
            bg='#2b2b2b'
        ).pack(pady=5)
        
        # Navigation
        nav_frame = tk.Frame(content, bg='#2b2b2b')
        nav_frame.pack(pady=20)
        
        self.step1_next = tk.Button(
            nav_frame,
            text="NEXT →",
            command=lambda: self.show_step(2),
            bg='#007acc',
            fg='white',
            font=('Arial', 11, 'bold'),
            padx=30,
            pady=10,
            state='disabled'
        )
        self.step1_next.pack()
        
    def create_step2(self):
        """Step 2: Model Initialization"""
        self.step2 = tk.Frame(self.steps_container, bg='#2b2b2b')
        
        content = tk.Frame(self.step2, bg='#2b2b2b')
        content.pack(fill='both', expand=True, padx=20, pady=20)
        
        tk.Label(
            content,
            text="STEP 2: MODEL INITIALIZATION",
            font=('Arial', 14, 'bold'),
            fg='white',
            bg='#2b2b2b'
        ).pack(pady=(0, 10))
        
        # Status
        self.init_status = tk.Label(
            content,
            text="Click 'Initialize Model' to load the selected AI model",
            font=('Arial', 11),
            fg='#cccccc',
            bg='#2b2b2b'
        )
        self.init_status.pack(pady=10)
        
        # Progress bar
        self.progress = ttk.Progressbar(
            content,
            mode='indeterminate',
            length=400
        )
        self.progress.pack(pady=10)
        
        # Navigation
        nav_frame = tk.Frame(content, bg='#2b2b2b')
        nav_frame.pack(pady=20)
        
        tk.Button(
            nav_frame,
            text="← BACK",
            command=lambda: self.show_step(1),
            bg='#555555',
            fg='white',
            font=('Arial', 10),
            padx=20,
            pady=5
        ).pack(side='left', padx=5)
        
        self.init_btn = tk.Button(
            nav_frame,
            text="INITIALIZE MODEL",
            command=self.initialize_model,
            bg='#28a745',
            fg='white',
            font=('Arial', 10, 'bold'),
            padx=20,
            pady=5
        )
        self.init_btn.pack(side='left', padx=5)
        
        self.step2_next = tk.Button(
            nav_frame,
            text="NEXT →",
            command=lambda: self.show_step(3),
            bg='#555555',
            fg='white',
            font=('Arial', 10),
            padx=20,
            pady=5,
            state='disabled'
        )
        self.step2_next.pack(side='left', padx=5)
        
    def create_step3(self):
        """Step 3: Input Selection"""
        self.step3 = tk.Frame(self.steps_container, bg='#2b2b2b')
        
        content = tk.Frame(self.step3, bg='#2b2b2b')
        content.pack(fill='both', expand=True, padx=20, pady=20)
        
        tk.Label(
            content,
            text="STEP 3: PROVIDE INPUT",
            font=('Arial', 14, 'bold'),
            fg='white',
            bg='#2b2b2b'
        ).pack(pady=(0, 10))
        
        # Input area will be populated based on model type
        self.input_area = tk.Frame(content, bg='#3c3c3c', height=200)
        self.input_area.pack(fill='both', expand=True, pady=10)
        self.input_area.pack_propagate(False)  # Prevent shrinking
        
        # Default message
        self.input_placeholder = tk.Label(
            self.input_area,
            text="Please complete Step 2 first",
            font=('Arial', 11),
            fg='#888888',
            bg='#3c3c3c'
        )
        self.input_placeholder.pack(expand=True)
        
        # Navigation
        nav_frame = tk.Frame(content, bg='#2b2b2b')
        nav_frame.pack(pady=20)
        
        tk.Button(
            nav_frame,
            text="← BACK",
            command=lambda: self.show_step(2),
            bg='#555555',
            fg='white',
            font=('Arial', 10),
            padx=20,
            pady=5
        ).pack(side='left', padx=5)
        
        self.step3_next = tk.Button(
            nav_frame,
            text="NEXT →",
            command=lambda: self.show_step(4),
            bg='#555555',
            fg='white',
            font=('Arial', 10),
            padx=20,
            pady=5,
            state='disabled'
        )
        self.step3_next.pack(side='left', padx=5)
        
    def create_step4(self):
        """Step 4: Processing"""
        self.step4 = tk.Frame(self.steps_container, bg='#2b2b2b')
        
        content = tk.Frame(self.step4, bg='#2b2b2b')
        content.pack(fill='both', expand=True, padx=20, pady=20)
        
        tk.Label(
            content,
            text="STEP 4: PROCESSING",
            font=('Arial', 14, 'bold'),
            fg='white',
            bg='#2b2b2b'
        ).pack(pady=(0, 10))
        
        # Status
        self.process_status = tk.Label(
            content,
            text="Ready to process your input",
            font=('Arial', 11),
            fg='#cccccc',
            bg='#2b2b2b'
        )
        self.process_status.pack(pady=10)
        
        # Progress bar
        self.process_progress = ttk.Progressbar(
            content,
            mode='indeterminate',
            length=400
        )
        self.process_progress.pack(pady=10)
        
        # Results area
        self.results_area = tk.Frame(content, bg='#3c3c3c', height=150)
        self.results_area.pack(fill='both', expand=True, pady=10)
        self.results_area.pack_propagate(False)
        
        # Navigation
        nav_frame = tk.Frame(content, bg='#2b2b2b')
        nav_frame.pack(pady=20)
        
        tk.Button(
            nav_frame,
            text="← BACK",
            command=lambda: self.show_step(3),
            bg='#555555',
            fg='white',
            font=('Arial', 10),
            padx=20,
            pady=5
        ).pack(side='left', padx=5)
        
        self.process_btn = tk.Button(
            nav_frame,
            text="START PROCESSING",
            command=self.start_processing,
            bg='#28a745',
            fg='white',
            font=('Arial', 10, 'bold'),
            padx=20,
            pady=5
        )
        self.process_btn.pack(side='left', padx=5)
        
        tk.Button(
            nav_frame,
            text="RESTART",
            command=self.restart_wizard,
            bg='#ffc107',
            fg='black',
            font=('Arial', 10),
            padx=20,
            pady=5
        ).pack(side='left', padx=5)
        
 def on_model_selected(self, event):
        """Handle model selection"""
        model_name = self.model_var.get()
        if model_name in self.models:
            self.current_model = self.models[model_name]()
            self.model_status.config(text=f"Selected: {model_name}")
            self.step1_next.config(state='normal')
            print(f"✅ Model selected: {model_name}")
            
    def initialize_model(self):
        """Initialize the selected model"""
        if not self.current_model:
            messagebox.showerror("Error", "Please select a model first")
            return
            
        self.init_btn.config(state='disabled')
        self.progress.start()
        self.init_status.config(text="Initializing model...")
        
        def init_thread():
            try:
                success = self.current_model.initialize()
                self.after(0, self.on_initialization_complete, success)
            except Exception as e:
                self.after(0, self.on_initialization_complete, False, str(e))
                
        threading.Thread(target=init_thread, daemon=True).start()
        
    def on_initialization_complete(self, success, error_msg=None):
        """Handle initialization completion"""
        self.progress.stop()
        
        if success:
            self.init_status.config(text="✅ Model initialized successfully!")
            self.step2_next.config(state='normal')
            self.setup_input_interface()
        else:
            error_text = f"❌ Initialization failed: {error_msg}" if error_msg else "❌ Initialization failed"
            self.init_status.config(text=error_text)
            self.init_btn.config(state='normal')
            
    def setup_input_interface(self):
        """Setup input interface based on model type"""
        # Clear previous input
        for widget in self.input_area.winfo_children():
            widget.destroy()
            
        if not self.current_model:
            return
            
        model_type = self.current_model.get_model_type()
        
        if model_type == "text-to-video":
            self.setup_text_input()
        elif model_type == "image-to-3d":
            self.setup_file_input()
        else:
            self.setup_text_input()
            
    def setup_text_input(self):
        """Setup text input interface"""
        tk.Label(
            self.input_area,
            text="Enter your text prompt:",
            font=('Arial', 11),
            fg='white',
            bg='#3c3c3c'
        ).pack(anchor='w', pady=(10, 5), padx=10)
        
        self.text_input = tk.Text(
            self.input_area,
            height=8,
            bg='#2b2b2b',
            fg='white',
            insertbackground='white',
            font=('Arial', 10)
        )
        self.text_input.pack(fill='both', expand=True, padx=10, pady=5)
        
        # Enable next button when text is entered
        def on_text_change(event):
            text = self.text_input.get('1.0', 'end-1c').strip()
            self.step3_next.config(state='normal' if text else 'disabled')
            
        self.text_input.bind('<KeyRelease>', on_text_change)
        
    def setup_file_input(self):
        """Setup file input interface"""
        tk.Label(
            self.input_area,
            text="Select an image file:",
            font=('Arial', 11),
            fg='white',
            bg='#3c3c3c'
        ).pack(anchor='w', pady=(10, 5), padx=10)
        
        file_frame = tk.Frame(self.input_area, bg='#3c3c3c')
        file_frame.pack(fill='x', padx=10, pady=5)
        
        self.file_label = tk.Label(
            file_frame,
            text="No file selected",
            font=('Arial', 10),
            fg='#cccccc',
            bg='#3c3c3c',
            wraplength=400
        )
        self.file_label.pack(side='left', fill='x', expand=True)
        
        tk.Button(
            file_frame,
            text="Browse Files",
            command=self.browse_file,
            bg='#007acc',
            fg='white',
            font=('Arial', 10)
        ).pack(side='right')
        
        # Instructions
        tk.Label(
            self.input_area,
            text="Supported formats: PNG, JPG, JPEG, BMP",
            font=('Arial', 9),
            fg='#888888',
            bg='#3c3c3c'
        ).pack(anchor='w', padx=10, pady=(0, 10))
        def browse_file(self):
        """Browse for input file"""
        filetypes = [
            ('Image files', '*.png *.jpg *.jpeg *.bmp'),
            ('All files', '*.*')
        ]
        
        filename = filedialog.askopenfilename(
            title="Select Image File",
            filetypes=filetypes
        )
        
        if filename:
            self.file_path = filename
            self.file_label.config(text=os.path.basename(filename))
            self.step3_next.config(state='normal')
            print(f"✅ File selected: {filename}")
            
    def start_processing(self):
        """Start processing the input"""
        if not self.current_model:
            messagebox.showerror("Error", "No model selected")
            return
            
        # Get input data based on model type
        model_type = self.current_model.get_model_type()
        input_data = None
        
        if model_type == "text-to-video":
            input_data = self.text_input.get('1.0', 'end-1c').strip()
            if not input_data:
                messagebox.showerror("Error", "Please enter text input")
                return
        elif model_type == "image-to-3d":
            input_data = self.file_path
            if not input_data or not os.path.exists(input_data):
                messagebox.showerror("Error", "Please select a valid file")
                return
        else:
            input_data = self.text_input.get('1.0', 'end-1c').strip()
            
        self.process_btn.config(state='disabled')
        self.process_progress.start()
        self.process_status.config(text="Processing your input...")
        
        # Clear previous results
        for widget in self.results_area.winfo_children():
            widget.destroy()
            
        # Show processing message
        processing_label = tk.Label(
            self.results_area,
            text="Processing... Please wait",
            font=('Arial', 11),
            fg='#cccccc',
            bg='#3c3c3c'
        )
        processing_label.pack(expand=True)
            
        def process_thread():
            try:
                result = self.current_model.process_input(input_data)
                self.after(0, self.on_processing_complete, result)
            except Exception as e:
                self.after(0, self.on_processing_complete, None, str(e))
                
        threading.Thread(target=process_thread, daemon=True).start()
        
    def on_processing_complete(self, result, error_msg=None):
        """Handle processing completion"""
        self.process_progress.stop()
        self.process_btn.config(state='normal')
        
        if error_msg:
            self.process_status.config(text=f"❌ Processing failed: {error_msg}")
            messagebox.showerror("Processing Error", error_msg)
            return
            
        if result and result.get('success', False):
            self.process_status.config(text="✅ Processing completed successfully!")
            self.display_results(result)
        else:
            error_msg = result.get('error', 'Unknown error') if result else 'No result returned'
            self.process_status.config(text=f"❌ Processing failed: {error_msg}")
            
    def display_results(self, result):
        """Display processing results"""
        # Clear previous results
        for widget in self.results_area.winfo_children():
            widget.destroy()
            
        tk.Label(
            self.results_area,
            text="PROCESSING RESULTS:",
            font=('Arial', 12, 'bold'),
            fg='white',
            bg='#3c3c3c'
        ).pack(anchor='w', pady=(10, 5), padx=10)
        
        # Display result data in a readable format
        if 'data' in result:
            result_text = self.format_results(result['data'])
            result_label = tk.Label(
                self.results_area,
                text=result_text,
                font=('Arial', 10),
                fg='#cccccc',
                bg='#3c3c3c',
                justify='left',
                wraplength=500
            )
            result_label.pack(anchor='w', padx=10, pady=5, fill='both', expand=True)
            
    def format_results(self, data):
        """Format results for display"""
        if isinstance(data, dict):
            lines = []
            for key, value in data.items():
                # Format key: convert camelCase to Title Case
                formatted_key = ' '.join(word.capitalize() for word in key.split('_'))
                lines.append(f"• {formatted_key}: {value}")
            return '\n'.join(lines)
        else:
            return str(data)
            
    def show_step(self, step_number):
        """Show the specified step"""
        self.current_step = step_number
        
        # Hide all steps
        for step in [self.step1, self.step2, self.step3, self.step4]:
            step.pack_forget()
            
        # Show current step
        if step_number == 1:
            self.step1.pack(fill='both', expand=True)
        elif step_number == 2:
            self.step2.pack(fill='both', expand=True)
        elif step_number == 3:
            self.step3.pack(fill='both', expand=True)
        elif step_number == 4:
            self.step4.pack(fill='both', expand=True)
            
        print(f"🎯 Showing step {step_number}")
        
    def restart_wizard(self):
        """Restart the wizard"""
        self.current_model = None
        self.model_var.set('')
        self.model_status.config(text="Please select a model to begin")
        self.file_path = None
        
        # Reset buttons
        self.step1_next.config(state='disabled')
        self.step2_next.config(state='disabled')
        self.step3_next.config(state='disabled')
        
        # Reset initialization
        self.init_btn.config(state='normal')
        self.init_status.config(text="Click 'Initialize Model' to load the selected AI model")
        
        # Clear inputs
        if hasattr(self, 'text_input') and self.text_input.winfo_exists():
            self.text_input.delete('1.0', 'end')
        if hasattr(self, 'file_label') and self.file_label.winfo_exists():
            self.file_label.config(text="No file selected")
            
        # Reset input area
        for widget in self.input_area.winfo_children():
            widget.destroy()
            
        self.input_placeholder = tk.Label(
            self.input_area,
            text="Please complete Step 2 first",
            font=('Arial', 11),
            fg='#888888',
            bg='#3c3c3c'
        )
        self.input_placeholder.pack(expand=True)
        
        # Clear results
        for widget in self.results_area.winfo_children():
            widget.destroy()
            
        self.process_status.config(text="Ready to process your input")
            
        self.show_step(1)
        print("🔄 Wizard restarted")
